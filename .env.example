# Clé API v3 créée dans Brevo > SMTP & API > Clés API
BREVO_API_KEY=

# Expéditeur vérifié dans Brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Acheque Stael"

# Adresse qui reçoit les messages du formulaire de contact
BREVO_CONTACT_EMAIL=

# Double opt-in newsletter Brevo
BREVO_NEWSLETTER_LIST_ID=
BREVO_DOI_TEMPLATE_ID=

# URL publique du site, sans slash final (ex. https://acheque-stael.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
